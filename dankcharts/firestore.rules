rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each user can only read and write their own config document
    match /users/{uid}/data/{doc} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Shared awards ceremonies: a frozen, public copy of one year's ceremony.
    // Anyone holding the link can open it — no account needed — but nobody can
    // list the collection, and only the account that made a copy can change or
    // delete it. The size check keeps a document from being used as free storage.
    match /sharedCeremonies/{id} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
                    && request.resource.data.owner == request.auth.uid
                    && request.resource.data.cats is list
                    && request.resource.data.cats.size() <= 80;
      allow update: if request.auth != null
                    && resource.data.owner == request.auth.uid
                    && request.resource.data.owner == request.auth.uid
                    && request.resource.data.cats is list
                    && request.resource.data.cats.size() <= 80;
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }

    // ── Community board (board.js) ──────────────────────────────────────────
    // Public to read. Posting, replying and voting need a signed-in account.
    // Moderators are listed in boardAdmins/{uid} — an (empty) document per
    // moderator, created by hand in the Firebase Console. Nobody can write that
    // collection from the site, and each user can only check their own entry.

    function signedIn() { return request.auth != null; }
    function isBoardAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/boardAdmins/$(request.auth.uid));
    }
    function textOk(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    // A post's or reply's pictures: a list of up to 4 {id, w, h} pointing at
    // boardImages docs. Leaving the field out means no pictures.
    function imagesOk(d) { return !('images' in d) || (d.images is list && d.images.size() <= 4); }
    function hasImages(d) { return 'images' in d && d.images is list && d.images.size() > 0; }
    function postPath(postId) { return /databases/$(database)/documents/boardPosts/$(postId); }
    function replyPath(postId, replyId) {
      return /databases/$(database)/documents/boardPosts/$(postId)/replies/$(replyId);
    }

    // ── YouTube search memory (app.js, _ytMemGet/_ytMemPut) ─────────────────
    // Site-wide: query → videoId, so a song anyone has played never costs
    // YouTube API quota again. Anyone can look a query up; nobody can list
    // the collection. Signed-in users add entries and remove ones that turn
    // out unplayable. Each entry is tiny and checked to be a real video id.
    match /ytCache/{id} {
      allow get: if true;
      allow list: if false;
      allow create, update: if signedIn()
        && id.matches('^[0-9a-f]{40}$')
        && request.resource.data.keys().hasOnly(['v', 'q', 'at'])
        && request.resource.data.v is string
        && request.resource.data.v.matches('^[A-Za-z0-9_-]{11}$')
        && textOk(request.resource.data.q, 1, 300)
        && request.resource.data.at == request.time;
      allow delete: if signedIn();
    }

    // ── The Dank 100 (dank100.js) ──────────────────────────────────────────
    // One entry per account per week: dank100Entries/{week}_{uid}, where week
    // is the Friday (UTC) that starts the tracking week, e.g. "2026-10-30".
    // Only the owner can read or change their entry, and only while the week
    // is open: from its Friday until the Sunday after it ends (10 days), or,
    // for any 2026 week sent with "Send my year", until 30 Nov. The
    // combined chart is built by a Cloudflare Function with the service
    // account, which skips these rules. Lists are capped at 100 rows each
    // (MAX_ROWS in dank100.js); the function cleans each row when it counts.
    function d100Owner(entryId) {
      return signedIn() && entryId.split('_').size() == 2 && entryId.split('_')[1] == request.auth.uid;
    }
    function d100RowsOk(v) { return v is list && v.size() <= 100; }

    match /dank100Entries/{entryId} {
      allow get: if d100Owner(entryId);
      allow list: if false;
      allow create, update: if d100Owner(entryId)
        && request.resource.data.keys().hasOnly(['uid', 'week', 'weekStart', 'updatedAt', 'v',
             'plays', 'songs', 'artists', 'albums'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.week is string
        && request.resource.data.week.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && entryId == request.resource.data.week + '_' + request.auth.uid
        // weekStart must be the Friday the id names, at midnight UTC
        && request.resource.data.weekStart == timestamp.date(
             int(request.resource.data.week[0:4]),
             int(request.resource.data.week[5:7]),
             int(request.resource.data.week[8:10]))
        && request.resource.data.weekStart.dayOfWeek() == 5
        && request.time >= request.resource.data.weekStart
        && (
          // a live week: from its Friday until the Sunday after it ends
          request.time < request.resource.data.weekStart + duration.value(10, 'd')
          // or any week since 2 Jan 2026 with "Send my year", until 30 Nov:
          // the weeks before the first live one, and (since 2026-11-01) the
          // live weeks that already closed, so late joiners get them too.
          // Weeks that haven't started are still refused by the check above.
          || (request.resource.data.week >= '2026-01-02'
              && request.time < timestamp.date(2026, 12, 1)))
        && request.resource.data.updatedAt == request.time
        && request.resource.data.v is int
        && request.resource.data.plays is int && request.resource.data.plays >= 1
        && d100RowsOk(request.resource.data.songs)
        && d100RowsOk(request.resource.data.artists)
        && d100RowsOk(request.resource.data.albums);
      allow delete: if d100Owner(entryId);
    }
    // The finished charts, one per week (functions/dank100). Anyone can read
    // one; only the function (service account) writes them.
    match /dank100Charts/{week} {
      allow get: if true;
      allow list, write: if false;
    }
    // Private to the function: the running history behind NEW / RE / peak,
    // and accounts kept out of the count (added by hand in the Console).
    match /dank100History/{week} {
      allow read, write: if false;
    }
    // When history entries last came in (functions/dank100); function only
    match /dank100Meta/{doc} {
      allow read, write: if false;
    }
    // Entries that look copied, written by the function when it builds a week
    match /dank100Flags/{week} {
      allow read, write: if false;
    }
    match /dank100Excluded/{uid} {
      allow read, write: if false;
    }

    match /boardAdmins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    match /boardPosts/{postId} {
      allow read: if true;

      // A new post starts open, unpinned, with no votes or replies, stamped
      // with the server's clock and the poster's own uid.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['title', 'body', 'category', 'authorUid', 'authorName',
             'authorPhoto', 'createdAt', 'lastActivity', 'status', 'pinned', 'votes', 'voteCount', 'replyCount', 'images'])
        && imagesOk(request.resource.data)
        && request.resource.data.authorUid == request.auth.uid
        && textOk(request.resource.data.title, 3, 120)
        && textOk(request.resource.data.body, 0, 5000)
        && request.resource.data.category in ['suggestion', 'bug', 'question', 'discussion']
        && textOk(request.resource.data.authorName, 1, 60)
        && textOk(request.resource.data.authorPhoto, 0, 500)
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastActivity == request.time
        && request.resource.data.status == 'open'
        && request.resource.data.pinned == false
        && request.resource.data.votes == []
        && request.resource.data.voteCount == 0
        && request.resource.data.replyCount == 0;

      allow update: if signedIn() && (
        // 1. The author edits their own text or category.
        (resource.data.authorUid == request.auth.uid
          && changedOnly(['title', 'body', 'category', 'editedAt', 'images'])
          && imagesOk(request.resource.data)
          && textOk(request.resource.data.title, 3, 120)
          && textOk(request.resource.data.body, 0, 5000)
          && request.resource.data.category in ['suggestion', 'bug', 'question', 'discussion']
          && request.resource.data.editedAt == request.time)
        ||
        // 2. Anyone signed in adds or removes their OWN vote — exactly one uid
        //    in or out, and voteCount kept equal to the list's length.
        (changedOnly(['votes', 'voteCount'])
          && request.resource.data.votes is list
          && request.resource.data.voteCount == request.resource.data.votes.size()
          && (
            (!(request.auth.uid in resource.data.votes)
              && request.resource.data.votes.size() == resource.data.votes.size() + 1
              && request.resource.data.votes.hasAll(resource.data.votes)
              && request.auth.uid in request.resource.data.votes)
            ||
            ((request.auth.uid in resource.data.votes)
              && request.resource.data.votes.size() == resource.data.votes.size() - 1
              && resource.data.votes.hasAll(request.resource.data.votes)
              && !(request.auth.uid in request.resource.data.votes))
          ))
        ||
        // 3. The reply counter, only in the same batch that adds a new reply
        //    (lastReplyId names it) or removes an existing one.
        (changedOnly(['replyCount', 'lastActivity', 'lastReplyId'])
          && (
            (request.resource.data.replyCount == resource.data.replyCount + 1
              && request.resource.data.lastActivity == request.time
              && !exists(replyPath(postId, request.resource.data.lastReplyId))
              && existsAfter(replyPath(postId, request.resource.data.lastReplyId)))
            ||
            (request.resource.data.replyCount == resource.data.replyCount - 1
              && request.resource.data.lastActivity == resource.data.lastActivity
              && exists(replyPath(postId, request.resource.data.lastReplyId))
              && !existsAfter(replyPath(postId, request.resource.data.lastReplyId)))
          ))
        ||
        // 4. Moderators set the status and pin/unpin.
        (isBoardAdmin()
          && changedOnly(['status', 'pinned'])
          && request.resource.data.status in ['open', 'planned', 'progress', 'done', 'declined']
          && request.resource.data.pinned is bool)
      );

      allow delete: if signedIn() && (resource.data.authorUid == request.auth.uid || isBoardAdmin());

      match /replies/{replyId} {
        allow read: if true;
        // Must go in together with the post's counter bump (rule 3 above).
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['body', 'authorUid', 'authorName', 'authorPhoto', 'createdAt', 'images'])
          && request.resource.data.authorUid == request.auth.uid
          && imagesOk(request.resource.data)
          // text, or just a picture
          && (textOk(request.resource.data.body, 1, 3000)
              || (textOk(request.resource.data.body, 0, 0) && hasImages(request.resource.data)))
          && textOk(request.resource.data.authorName, 1, 60)
          && textOk(request.resource.data.authorPhoto, 0, 500)
          && request.resource.data.createdAt == request.time
          && exists(postPath(postId))
          && getAfter(postPath(postId)).data.replyCount == get(postPath(postId)).data.replyCount + 1;
        allow update: if false;
        // The reply's author, the post's author (moderating their own thread,
        // and clearing replies when deleting the post) or a moderator.
        allow delete: if signedIn() && (
          resource.data.authorUid == request.auth.uid
          || get(postPath(postId)).data.authorUid == request.auth.uid
          || isBoardAdmin());
      }
    }

    // ── Board pictures (board.js) ───────────────────────────────────────────
    // One picture per doc as a WebP/JPEG/PNG data URL, shrunk in the browser
    // to fit. Anyone can open one by id; nobody can list them. Only the
    // signed-in uploader adds one, never changes it, and the uploader or a
    // moderator removes it. The size cap keeps a doc from being free storage.
    match /boardImages/{imageId} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['data', 'w', 'h', 'authorUid', 'createdAt'])
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 750000
        && request.resource.data.data[0:30].matches('data:image/(webp|jpeg|png);base64,.*')
        && request.resource.data.w is int && request.resource.data.w > 0 && request.resource.data.w <= 4000
        && request.resource.data.h is int && request.resource.data.h > 0 && request.resource.data.h <= 4000
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn() && (resource.data.authorUid == request.auth.uid || isBoardAdmin());
    }
  }
}
