# ── YouTube ─────────────────────────────────────────────────────────────────────
# YouTube Data API v3 key — used to search for videos when streaming from charts
# Get one at console.cloud.google.com → APIs & Services → YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here

# ── Resend ──────────────────────────────────────────────────────────────────────
# API key for the welcome email sent on first sign-in (mailer.py)
RESEND_API_KEY=your_resend_api_key_here
